{
  "name": "bouncewave",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=desktop --project=phone-portrait --project=phone-landscape",
    "test:perf": "playwright test --project=perf",
    "test:visual": "playwright test --project=visual",
    "sim": "vitest run --config vitest.sim.config.ts",
    "render": "node scripts/render.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "pwa-assets-generator && pwa-assets-generator --config pwa-assets.favicon.config.ts && node scripts/splash.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/preact": "^3.2.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/tektur": "^5.3.0",
    "@preact/signals-core": "^1.14.4",
    "preact": "^10.29.8",
    "valibot": "^1.5.0"
  }
}
